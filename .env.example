# ============================================================================
# APC 环境变量模板
# 用法：cp .env.example .env 后填值。`.env` 已被 .gitignore 忽略，切勿提交。
# 加载：`apc` CLI 与 `python -m apc.graph` 启动时自动加载仓库根 `.env`
#       （python-dotenv；已在 apc-pipeline 依赖中）。
# 优先级：同名字段 环境变量 > configs/models/<id>.yaml > 内置默认。
# ============================================================================

# ---------- 1. 供应商凭证（填了哪个，哪个供应商的 --no-mock 才能走真实 API） ----------
# 留空 = 无凭证，该供应商自动回退 MockClient（默认 --mock 行为不变）。
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
ZHIPUAI_API_KEY=

# ---------- 2. 覆盖已有模型（configs/models/glm.yaml / qwen.yaml / gpt.yaml） ----------
# 规则：APC_<MODEL_ID 大写>_<字段>，MODEL_ID 中的连字符转下划线（如 my-model → APC_MY_MODEL_*）。
# 字段：PROVIDER / BASE_URL（别名 API_BASE）/ MODEL / NAME / API_KEY / API_KEY_ENV /
#       MAX_TOKENS / TEMPERATURE。只填要改的，不填则沿用 yaml。

# 例：智谱 glm 改走自建网关、换模型名
APC_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
APC_GLM_MODEL=glm-4
# APC_GLM_MAX_TOKENS=2000
# APC_GLM_TEMPERATURE=0.0

# 例：通义 qwen 只换模型名（base_url 沿用 yaml）
# APC_QWEN_MODEL=qwen-max

# 例：OpenAI 换兼容网关（如本地 Ollama / vLLM 服务）
# APC_GPT_BASE_URL=http://localhost:11434/v1
# APC_GPT_MODEL=llama3.1
# APC_GPT_API_KEY=ollama

# ---------- 3. 纯环境变量定义新模型（无需写 yaml，开箱即用） ----------
# MODEL + BASE_URL 必填；PROVIDER 默认 custom；
# 凭证三选一：API_KEY（直填）/ API_KEY_ENV（指向存 key 的变量名）/ PROVIDER 对应的供应商 key。
# 例：新增 deepseek（无 configs/models/deepseek.yaml 也能用）
# APC_DEEPSEEK_MODEL=deepseek-chat
# APC_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# APC_DEEPSEEK_API_KEY=
# APC_DEEPSEEK_MAX_TOKENS=2000
# APC_DEEPSEEK_TEMPERATURE=0.0

# ---------- 4. 管线自身 ----------
# 数据库（默认 <repo>/data/apc.db）
# APC_DB_URL=sqlite:////abs/path/to/apc.db
# 探针套件目录（默认 <repo>/probes/v1）
# APC_PROBE_DIR=/path/to/probes/v1
# 出境代理（如需；httpx[socks] 已在依赖中）
# ALL_PROXY=socks5h://127.0.0.1:1080
